{
  "name": "react-resume-template",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "build": "yarn compile && yarn next build",
    "clean": "rm -rf build-tsc .next",
    "compile": "tsc --noEmit --incremental false",
    "dev": "yarn compile && yarn next dev",
    "format": "prettier --write './src/**/*.{js,jsx,json,ts,tsx}'",
    "lint": "eslint './src/**/*.{js,jsx,ts,tsx}' --max-warnings=0",
    "lint:fix": "eslint './src/**/*.{js,jsx,ts,tsx}' --fix --max-warnings=0",
    "postbuild": "yarn next-sitemap",
    "preview": "serve out --listen tcp://127.0.0.1:3100",
    "start": "yarn next start",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit --incremental false",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit --incremental false"
  },
  "dependencies": {
    "@headlessui/react": "^1.7.16",
    "@heroicons/react": "^2.0.18",
    "autoprefixer": "10.4.16",
    "axios": "^1.7.2",
    "classnames": "^2.3.2",
    "next": "^14.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-force-graph-3d": "^1.29.1",
    "three": "0.184.0",
    "three-spritetext": "^1.10.0",
    "ts-pattern": "^5.0.4"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^14.0.3",
    "@playwright/test": "1.63.0",
    "@tailwindcss/forms": "^0.5.4",
    "@tailwindcss/typography": "^0.5.9",
    "@types/node": "^20.4.5",
    "@types/react": "^18.2.18",
    "@types/three": "^0.184.1",
    "@types/webpack-env": "^1.18.1",
    "@typescript-eslint/eslint-plugin": "^6.2.1",
    "@typescript-eslint/parser": "^6.2.1",
    "cssnano": "^6.0.1",
    "eslint": "^8.46.0",
    "eslint-config-next": "^14.0.3",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.28.0",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-module-resolver": "^1.5.0",
    "eslint-plugin-monorepo": "^0.3.2",
    "eslint-plugin-react": "^7.33.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-memo": "^0.0.3",
    "eslint-plugin-react-native": "^4.0.0",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "eslint-plugin-sort-keys-fix": "^1.1.2",
    "next-sitemap": "^4.2.3",
    "postcss": "^8.4.27",
    "postcss-preset-env": "^9.1.0",
    "prettier": "^3.0.0",
    "prettier-plugin-tailwindcss": "^0.5.7",
    "sass": "^1.64.2",
    "serve": "14.2.6",
    "sort-package-json": "^2.5.1",
    "stylelint": "^15.10.2",
    "stylelint-config-recommended": "^13.0.0",
    "stylelint-order": "^6.0.3",
    "stylelint-prettier": "^4.0.2",
    "tailwindcss": "^3.3.3",
    "typescript": "5.3.2"
  },
  "resolutions": {
    "autoprefixer": "10.4.5"
  }
}
